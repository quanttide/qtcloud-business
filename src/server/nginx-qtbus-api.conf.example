# nginx 反向代理示例：api.business.cloud.quanttide.com → 127.0.0.1:8787
# 证书按服务器现有证书路径调整（可用 certbot 签发 Let's Encrypt）

server {
    listen 443 ssl;
    http2 on;
    server_name api.business.cloud.quanttide.com;

    ssl_certificate     /etc/nginx/ssl/quanttide.com.pem;
    ssl_certificate_key /etc/nginx/ssl/quanttide.com.key;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 5m;
    }
}

server {
    listen 80;
    server_name api.business.cloud.quanttide.com;
    return 301 https://$host$request_uri;
}
